{
  "name": "@chatify/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/index.js",
    "start": "node --env-file-if-exists=.env src/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env src/db/migrate-cli.js",
    "db:studio": "node --env-file-if-exists=.env ./node_modules/.bin/drizzle-kit studio",
    "seed": "node --env-file-if-exists=.env src/db/seed-cli.js"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "argon2": "^0.45.2",
    "cookie": "^2.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "file-type": "^22.3.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "pino": "^10.4.0",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.11",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.2",
    "vitest": "^5.1.1"
  }
}
